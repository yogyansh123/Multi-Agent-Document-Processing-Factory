# =============================================================================
# Multi-Agent Document Processing Factory — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# =============================================================================

# -------------------------
# Application
# -------------------------
APP_ENV=development
APP_NAME="Multi-Agent Document Processing Factory"
APP_VERSION=0.2.0
DEBUG=true
LOG_LEVEL=INFO

# -------------------------
# Backend API
# -------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# PORT is automatically injected by cloud platforms (Render, Heroku, etc.):
# PORT=10000
BACKEND_RELOAD=true
# Allowed CORS origins (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Production frontend URL (Vercel deployment URL):
# FRONTEND_URL=https://your-frontend.vercel.app
# Regex for Vercel preview branch deployments:
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app
SECRET_KEY=dev_secret_key_change_in_production_32chars

# -------------------------
# PostgreSQL Database
# -------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=document_factory
POSTGRES_USER=docfactory
POSTGRES_PASSWORD=changeme_postgres_password

# Direct cloud database connection string (e.g., Render PostgreSQL, Supabase, Neon):
# If provided, DATABASE_URL takes precedence over POSTGRES_* settings.
# DATABASE_URL=postgresql+asyncpg://user:password@hostname:5432/dbname

# -------------------------
# Redis Cache
# -------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_STATUS_TTL_SECONDS=3600
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=changeme_redis_password
REDIS_DB=0

# -------------------------
# Temporal Workflow Engine
# -------------------------
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_HOST=localhost
TEMPORAL_PORT=7233
TEMPORAL_NAMESPACE=document-processing
TEMPORAL_TASK_QUEUE=document-processing-queue

# -------------------------
# LLM Provider (abstracted — pick one)
# -------------------------
LLM_PROVIDER=openai
# Supported: openai | anthropic | google | azure_openai | ollama

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google (Gemini)
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_MODEL=gemini-1.5-pro

# Azure OpenAI
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Ollama (local)
# For local host execution: http://localhost:11434
# For Docker container execution: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# -------------------------
# OCR Provider (abstracted — pick one)
# -------------------------
OCR_PROVIDER=tesseract
# Supported: tesseract | aws_textract | google_vision | azure_form_recognizer | unstructured

# Tesseract OCR settings
# Path to tesseract binary. Leave empty to use system PATH.
# Windows example: TESSERACT_CMD="C:\\Program Files\\Tesseract-OCR\\tesseract.exe"
TESSERACT_CMD=
OCR_LANGUAGE=eng
OCR_DPI=300
OCR_TEXT_PREVIEW_CHARS=1000

# AWS Textract
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1

# Google Cloud Vision
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Azure Form Recognizer
AZURE_FORM_RECOGNIZER_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_FORM_RECOGNIZER_KEY=your-azure-form-recognizer-key

# -------------------------
# Vector Database & RAG (Step 9)
# -------------------------
VECTOR_DB_PROVIDER=pgvector
# Supported: pgvector | chromadb | pinecone | weaviate | qdrant

# Embedding model (OpenAI)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# RAG chunking & context boundaries
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_MAX_CONTEXT_CHARS=12000
RAG_TOP_K_DEFAULT=5
RAG_TOP_K_MAX=20

# Pinecone (if VECTOR_DB_PROVIDER=pinecone)
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=your-pinecone-environment
PINECONE_INDEX_NAME=document-factory

# Weaviate (if VECTOR_DB_PROVIDER=weaviate)
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=your-weaviate-api-key

# Qdrant (if VECTOR_DB_PROVIDER=qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your-qdrant-api-key

# -------------------------
# File Storage
# -------------------------
STORAGE_BACKEND=local
# Supported: local | s3 | gcs | azure_blob

# Local filesystem storage root (relative to working directory or absolute path)
STORAGE_PATH=./storage

# Upload constraints
MAX_UPLOAD_SIZE_MB=25
# Allowed file extensions for uploads (comma-separated)
ALLOWED_UPLOAD_TYPES=pdf,png,jpg,jpeg,docx

# AWS S3 (used when STORAGE_BACKEND=s3)
S3_BUCKET_NAME=your-document-factory-bucket
S3_REGION=us-east-1

# -------------------------
# Security
# -------------------------
SECRET_KEY=changeme_generate_a_secure_random_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# -------------------------
# Processing
# -------------------------
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,png,jpg,jpeg,tiff,bmp,webp
PROCESSING_TIMEOUT_SECONDS=300
MAX_RETRY_ATTEMPTS=3
CONFIDENCE_THRESHOLD=0.85

# -------------------------
# Observability
# -------------------------
ENABLE_TRACING=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
SENTRY_DSN=your-sentry-dsn-here
